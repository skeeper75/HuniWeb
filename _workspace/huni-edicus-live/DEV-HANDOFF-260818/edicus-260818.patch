diff --git a/webadmin/catalog/edicus_lookup.py b/webadmin/catalog/edicus_lookup.py
index f4b0e3c..eca0d8b 100644
--- a/webadmin/catalog/edicus_lookup.py
+++ b/webadmin/catalog/edicus_lookup.py
@@ -261,3 +261,202 @@ def issue_token(guest_id, site_cd):
     if not token:
         return None, "editor_token_failed"
     return {"token": token, "partner": partner, "uid": uid}, None
+
+
+# ===========================================================================
+# Edicus 프로젝트·주문 API — 호출 계층만 (2026-08-18 조사분)
+# ===========================================================================
+#
+# @TODO(edicus-G7) 아래 함수들은 **어디에서도 호출되지 않는다**. 지금 붙이는 것은
+#   HTTP 호출 계층뿐이고, "언제 부를 것인가"(결제 완료 훅·취소 훅·주문 레코드 저장)는
+#   쇼핑몰 연동 구간이라 이 파일이 정할 수 없다. 배선 지점은 이 블록 맨 아래 참조.
+#
+# 규격 출처 — MotionOne/edicus-dev (공식 데모, 로컬 사본 raw/edicus_dev/):
+#   demo-basic/server.js   … 모든 엔드포인트·헤더의 1차 근거
+#   demo-basic/order.js    … tentative/definitive/cancel 의 상태 전이 주석
+#   ORDER_PROCESS.md       … editing → ordering → ordered 상태 흐름
+#
+# 공통 규칙(위 server.js callEdicusAPIAsync):
+#   - 헤더 `edicus-api-key`(비밀) + `edicus-uid`(고객 식별자). **서버에서만** 부른다.
+#     데모는 편의상 브라우저에서 부르지만 파일 상단이 "원래 고객사 server 에서
+#     api 형태로 구현되어야 한다"고 명시한다.
+#   - uid 는 `guest_uid()` 가 만드는 그 값이어야 한다. 편집기 토큰 발급 때 쓴 uid 와
+#     다르면 남의 프로젝트를 조회하는 셈이 되어 실패한다.
+#   - 응답 본문의 논리 오류는 `err` 키로 온다(HTTP 200 이어도 실패일 수 있다).
+
+
+def _edicus_api(path, method, uid, data=None):
+    """Edicus Server API 범용 호출 — ``(status_code, body_dict|None)``.
+
+    ``_edicus_token_request`` 와 같은 규약(네트워크·타임아웃·파싱 실패는 ``(0, None)``
+    으로 흡수, API 키는 로그에 절대 남기지 않음)을 따른다. 토큰 발급 함수를 건드리지
+    않고 나란히 두는 이유는, 이미 검증된 경로를 이번 추가분 때문에 흔들지 않기 위해서다.
+    """
+    body = b"{}" if data is None else json.dumps(data).encode("utf-8")
+    req = urllib.request.Request(
+        settings.EDICUS_API_HOST.rstrip("/") + path,
+        method=method,
+        headers={
+            "edicus-api-key": settings.EDICUS_API_KEY,
+            "edicus-uid": uid,
+            "User-Agent": _USER_AGENT,
+            "Content-Type": "application/json",
+        },
+        data=None if method == "GET" else body,
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=_HTTP_TIMEOUT) as resp:
+            return resp.status, json.loads(resp.read().decode("utf-8") or "{}")
+    except urllib.error.HTTPError as e:
+        try:
+            return e.code, json.loads(e.read().decode("utf-8") or "{}")
+        except (ValueError, UnicodeDecodeError):
+            return e.code, None
+    except Exception:   # noqa: BLE001 — 네트워크/타임아웃 전부 실패로 흡수(fail-closed)
+        return 0, None
+
+
+def get_project(uid, prjid):
+    """``GET /api/projects/{prjid}`` — 프로젝트 상태 조회. ``(body|None, err_code)``.
+
+    응답에 ``order_id`` 와 주문 상태가 들어온다(공식 데모 demo-basic/index.js
+    ``refresh_project_data_table`` 이 ``projectData.order_id`` 를 읽는다).
+
+    **주문 가능 판정의 권위가 여기다.** 잠정주문은 상태가 ``editing`` 일 때만 되고,
+    확정주문은 ``ordering`` 일 때만 된다(demo-basic/order.js 주석). 편집기가 저장되지
+    않은 채 닫힌 경우를 잡으려면 결제 직전 이 값을 확인하는 것이 가장 확실하다.
+
+    주의 — 상태값이 본문 어느 키에 실리는지(``order.status`` 인지 최상위 ``status`` 인지)는
+    공식 데모가 표를 그리기만 하고 키를 못박지 않아 **미확인**이다. 실제 응답 1건을
+    받아보고 확정할 것. 추정으로 파싱하지 말 것.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api("/api/projects/" + str(prjid), "GET", uid)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_project_fetch_failed"
+    return body, None
+
+
+def tentative_order(uid, prjid, order):
+    """``POST /api/projects/{prjid}/order/tentative`` — 잠정주문. ``(body|None, err_code)``.
+
+    상태 ``editing`` → ``ordering``. 이후 고객은 편집기를 열어도 **저장할 수 없고**,
+    주문은 아직 **취소 가능**하다(ORDER_PROCESS.md).
+
+    ``order`` 본문 (demo-basic/order.js 그대로):
+        order_for_test    bool  기본 False
+        order_count       int   ★ 수수료 정산 데이터 — 정확히 넣어야 한다
+        total_price       int   ★ 수수료 정산 데이터 — 정확히 넣어야 한다
+        partner_order_id  str   우리 주문번호. Edicus 주문번호와 대응시켜 추적에 쓴다
+        order_name        str   실제 주문자명
+
+    @TODO(edicus-G7) 응답의 주문번호(order_id)를 **반드시 우리 주문 레코드에 저장**할 것.
+      취소는 project_id 가 아니라 order_id 로 부른다(cancel_order 참조) — 안 남기면
+      취소할 방법이 없다.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api(
+        "/api/projects/" + str(prjid) + "/order/tentative", "POST", uid, order)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_tentative_failed"
+    return body, None
+
+
+def definitive_order(uid, prjid):
+    """``POST /api/projects/{prjid}/order/definitive`` — 확정주문. ``(body|None, err_code)``.
+
+    상태 ``ordering`` → ``ordered``. 이 시점부터 **취소 불가**이고, 고해상도 생산파일
+    (PDF·JPG 등) 렌더링이 시작된다(ORDER_PROCESS.md). 본문은 비운다.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api(
+        "/api/projects/" + str(prjid) + "/order/definitive", "POST", uid)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_definitive_failed"
+    return body, None
+
+
+def cancel_order(uid, order_id):
+    """``POST /api/orders/{order_id}/cancel`` — 잠정주문 취소. ``(body|None, err_code)``.
+
+    ★ 경로가 다른 셋과 다르다 — ``/api/projects/{prjid}/…`` 가 아니라 **``/api/orders/{order_id}``**
+    다(demo-basic/server.js ``cancel_order_project``). ``order_id`` 는 잠정주문 응답이나
+    ``get_project()`` 로 얻는다.
+
+    상태 ``ordering`` 일 때만 되고, 성공하면 ``editing`` 으로 되돌아가 고객이 다시
+    편집할 수 있다. 확정주문은 취소할 수 없다.
+    가변데이터(VDP) 주문을 취소하면 데이터가 삭제되고 복구되지 않는다.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api("/api/orders/" + str(order_id) + "/cancel", "POST", uid)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_cancel_failed"
+    return body, None
+
+
+def clone_project(uid, prjid):
+    """``POST /api/projects/{prjid}/clone`` — 프로젝트 복제. ``(body|None, err_code)``.
+
+    @TODO(edicus-G9) 재주문 설계의 열쇠. 주문된 프로젝트는 편집도 삭제도 안 되므로,
+      "같은 걸로 또" 는 원본을 복제해 새 프로젝트로 여는 것이 정답 경로다.
+      다만 Edicus 가 주문완료 3~4주 뒤 프로젝트를 자동 삭제하므로, 그 기간이 지나면
+      복제할 원본 자체가 없다(=재주문 불가 구간). 정확한 일수는 여전히 미확인.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api("/api/projects/" + str(prjid) + "/clone", "POST", uid)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_clone_failed"
+    return body, None
+
+
+def delete_project(uid, prjid):
+    """``DELETE /api/projects/{prjid}`` — 프로젝트 삭제. ``(body|None, err_code)``.
+
+    **주문된 프로젝트는 삭제되지 않는다.** 장바구니에서 뺀 미주문 디자인을 정리하는 용도다.
+    """
+    if not (settings.EDICUS_API_KEY and settings.EDICUS_API_HOST):
+        return None, "editor_not_configured"
+    status, body = _edicus_api("/api/projects/" + str(prjid), "DELETE", uid)
+    if status != 200 or not isinstance(body, dict) or body.get("err"):
+        return None, "edicus_delete_failed"
+    return body, None
+
+
+# ---------------------------------------------------------------------------
+# @TODO(edicus-G7) 배선 — 위 함수들을 어디서 부를 것인가
+# ---------------------------------------------------------------------------
+#
+# 지금 상태: 결제가 끝나도 Edicus 쪽 프로젝트는 editing 에 머물고, 인쇄 데이터 생성이
+#            시작되지 않는다. 우리가 부르는 Edicus API 는 토큰 발급 하나뿐이다.
+#
+# 필요한 배선 4곳 — 어느 것도 이 파일에서 결정할 수 없다(쇼핑몰 연동 구간):
+#
+#   ① 결제 완료 훅
+#        주문의 editors[].result.prjid 마다
+#          get_project(uid, prjid) 로 상태 확인 → editing 이 아니면 중단하고 알림
+#          tentative_order(uid, prjid, {...}) → 응답 order_id 를 주문 레코드에 저장
+#          definitive_order(uid, prjid)
+#        · tentative 와 definitive 사이에 무엇을 둘지가 설계 결정이다. 결제 확정과
+#          생산 개시를 분리하려면 사이를 벌리고, 아니면 연달아 부른다.
+#        · uid 는 주문 당시 고객의 uid 여야 한다 — guest_uid(partner, site_cd, guest_id).
+#          주문 레코드에 guest_id·site_cd 가 남아 있지 않으면 재현할 수 없으므로,
+#          없다면 그것부터 저장해야 한다. ★ 선행 확인 항목
+#
+#   ② 주문 취소 훅
+#        저장해 둔 order_id 로 cancel_order(uid, order_id).
+#        확정주문 이후에는 실패한다 — 취소 가능 구간을 UI 에서 미리 막을 것.
+#
+#   ③ 재주문
+#        clone_project(uid, prjid) → 새 prjid 로 편집기를 연다. (edicus-G9)
+#
+#   ④ 장바구니에서 뺄 때
+#        delete_project(uid, prjid) 로 미주문 디자인 정리. 안 지워도 Edicus 가
+#        언젠가 지우지만 그 기간이 미확인이라, 우리가 지우는 편이 예측 가능하다.
+#
+# 검증 방법: 위 함수들은 테스트에서 _edicus_api 를 monkeypatch 해 실 HTTP 없이 확인한다
+#            (_edicus_token_request 선례와 동일).
