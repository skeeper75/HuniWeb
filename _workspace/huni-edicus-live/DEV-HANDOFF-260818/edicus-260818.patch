+/* ============================================================
+   후니프린팅 Edicus 편집기 테마 — private_css 주입용 · 안 B — 다크 패널
+   근거: edicusbase.firebaseapp.com/styles.dda665f6ba99a960b3c3.css 실측 (2026-08-18)
+   토큰: 후니 디자인시스템 v5.0.0
+   차이: Edicus 기본 다크면을 유지하고 강조색만 후니 보라로 바꾼다. 흰 종이가
+           도드라지고 override 가 6줄이라 Edicus UI 변경에 덜 깨진다.
+   상태: [결정 대기] 두 안 비교 캡처 = _workspace/huni-edicus-live/theme-compare/
+   주입: huni_editor_sdk.js 가 이 파일을 fetch 해 private_css 로 넘긴다
+           (edicus-sdk-v2.js 의 wait_private_css → waiting-for-extra-param 2단 핸드셰이크)
+   ============================================================ */
+
+/* ── 헤더 ───────────────────────────── (원래 #64c2ff 하늘색) */
+.theme-header-bg            { background-color:#5538B6 !important }
+.theme-header-border        { border-color:#351D87 !important }
+.theme-header-separator     { background-color:rgba(255,255,255,.25) !important }
+.theme-header-text          { color:rgba(255,255,255,.92) !important }
+.theme-header-btn           { color:rgba(255,255,255,.90) !important }
+.theme-header-btn:hover     { background-color:rgba(255,255,255,.18) !important }
+.theme-header-btn:active    { background-color:rgba(255,255,255,.28) !important }
+.theme-header-btn[disabled=true] { color:rgba(255,255,255,.35) !important }
+.theme-header-cart-btn      { color:#fff !important; background-color:#351D87 !important }
+.theme-header-cart-btn:hover{ background-color:#9580D9 !important }
+
+/* ── 탭 ─────────────────────────────── (Edicus 기본 다크면 유지, 강조색만 후니 보라)
+   다크 배경 위에서는 #5538B6 가 너무 어두워 읽히지 않으므로 밝은 보라 #9580D9 를 쓴다. */
+.theme-tab-btn              { color:#8c919d !important }
+.theme-tab-btn.active-tab   { color:#9580D9 !important }
+
+/* ── 좌측 도구 패널 ─────────────────── (다크면 유지, 강조만 보라) */
+.theme-panel-round-btn:hover             { border-color:#9580D9 !important }
+.theme-panel-toolbar-btn:hover           { border-color:#9580D9 !important }
+.theme-panel-toolbar-btn[active=true]    { color:#9580D9 !important; border-color:#9580D9 !important }
+
+/* ── 드롭다운 ───────────────────────── */
+.theme-ui-dropdown-item:hover,
+.theme-ui-dropdown-item:active { color:#5538B6 !important }
+
+/* ── 플러그인(슬라이더 등) — CSS 변수로 열려 있음 ── */
+.theme-plugin.m2 {
+  --normal-color:#5538B6;
+  --hover-color:rgba(85,56,182,.90);
+  --active-color:rgba(53,29,135,.97);
+  --track-color:#CACACA;
+  --thumb-color:#5538B6;
+  --select-color:#5538B6;
+}
+
+/* 폰트는 손대지 않음 — Edicus 기본이 "Noto Sans KR"로 후니 DS와 동일 */
+
+/* ⚠ 미결 사항
+   1) 좌측 패널을 라이트로 뒤집는 것이 맞는가 (원본은 다크 #3e4553·#262c33)
+      → 캔버스 주변을 어둡게 두면 작업물이 도드라지는 이점이 있음. 디자인 결정 필요
+   2) !important 없이도 적용되는가 (주입 순서 미확인)
+   3) theme-cell-empty-icon(63회) 등 나머지 theme-* 클래스 미매핑
+*/
